# ─── Database ──────────────────────────────────────
# Local: docker compose up -d
DATABASE_URL=postgresql://houseme:houseme@localhost:5432/houseme

# ─── Auth (Auth.js / NextAuth v5) ──────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Optional Google OAuth (not wired in scaffold)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Admin seed (used later by npm run db:seed)
# ADMIN_EMAIL=admin@houseme.ng
# ADMIN_PASSWORD=

# ─── Cloudinary (photo uploads — later) ────────────
# CLOUDINARY_CLOUD_NAME=houseme
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─── Email / Resend (later) ────────────────────────
# RESEND_API_KEY=
# EMAIL_FROM=noreply@houseme.ng

# ─── Maps (Mapbox default; Google is an alternative) ─
# NEXT_PUBLIC_MAPBOX_TOKEN=
# MAPBOX_SECRET=

# ─── Analytics (later) ─────────────────────────────
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=houseme.ng

# ─── App ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HouseMe
