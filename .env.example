# ─── Database ──────────────────────────────────────
# Local: docker compose up -d
# Production: Neon / Vercel Postgres pooled connection string
DATABASE_URL=postgresql://houseme:houseme@localhost:5432/houseme

# ─── Auth (Auth.js / NextAuth v5) ──────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Production: leave AUTH_DEMO_MODE and AUTH_STORE unset (use Postgres)
# Local demo without Docker:
# AUTH_DEMO_MODE=true
# AUTH_STORE=file

# ─── Cloudinary (free tier — listing + profile photos) ─
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─── Email / Resend (free tier — verify + resets) ──
# RESEND_API_KEY=
# EMAIL_FROM=HouseMe <onboarding@resend.dev>

# ─── Maps (Mapbox free tier geocoding) ─────────────
# NEXT_PUBLIC_MAPBOX_TOKEN=
# MAPBOX_SECRET=

# ─── Analytics ─────────────────────────────────────
# Vercel Analytics is enabled in-app (no key on Vercel).
# Optional Plausible:
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=houseme.ng

# ─── App ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HouseMe
